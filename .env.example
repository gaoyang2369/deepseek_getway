# Generate real values with scripts/init_secrets.py; this example is not deployable.
GATEWAY_ENV=production
PUBLIC_URL=https://YOUR-LAB-DOMAIN
UPSTREAM_URL=https://api.deepseek.com/v1
DATABASE_URL=postgresql+psycopg://lab_gateway:SET_BY_INIT@postgres:5432/lab_gateway
REDIS_URL=redis://:SET_BY_INIT@redis:6379/0
ADMIN_NAME=admin
# Optional contact address shown to students; no automatic email is sent.
SUPPORT_EMAIL=
GATEWAY_BIND_HOST=127.0.0.1
GATEWAY_PORT=18081
# Specify only the addresses of actual reverse proxies. Empty = trust none.
TRUSTED_PROXIES=
RETENTION_DAYS=90
BUDGET_THRESHOLDS=80,100
